{
  "name": "git-archaeologist",
  "version": "1.31.0",
  "description": "Find the most dangerous files in any git repo — curse scores, bus factor, hidden coupling",
  "main": "dist/index.js",
  "bin": {
    "git-arch": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\"",
    "lint": "eslint \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "git",
    "cli",
    "code-quality",
    "tech-debt",
    "analytics",
    "bus-factor",
    "ownership",
    "coupling",
    "blame",
    "git-analysis",
    "mcp",
    "ai-agent",
    "model-context-protocol"
  ],
  "author": "Sushant Verma",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^9.5.0",
    "ora": "^5.4.1",
    "zod": "^4.4.3"
  },
  "homepage": "https://github.com/SushantVerma7969/git-archaeologist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SushantVerma7969/git-archaeologist.git"
  },
  "bugs": {
    "url": "https://github.com/SushantVerma7969/git-archaeologist/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
