# Dependencies
node_modules/
action/node_modules/

# Build output — built fresh on publish (prepublishOnly) and in CI, never committed
dist/

# Source maps
*.js.map
*.d.ts.map

# Generated reports
git-arch-report-*.html

# Research data — archived outside the repo, not tracked
research/

# OS
.DS_Store

# The GitHub Action bundle MUST be committed — Actions run the file at `main:`
# directly with no build step. action/node_modules stays ignored; the bundled
# action/dist/index.js (produced by `npm run build:action`) is committed.
!action/dist/
